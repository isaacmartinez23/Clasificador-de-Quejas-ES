# Copia este archivo a .env y completa los valores. .env no se sube a git.

# Proveedor del LLM: gemini | openai
LLM_PROVIDER=gemini

# Clave de API del proveedor elegido
LLM_API_KEY=

# Nombre del modelo tal como lo publica el proveedor
LLM_MODEL=

# Tope de gasto en USD: las corridas masivas se abortan si la estimación lo supera
LLM_BUDGET_USD=10
